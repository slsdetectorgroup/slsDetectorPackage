diff --git a/slsDetectorCalibration/jungfrauExecutables/Makefile b/slsDetectorCalibration/jungfrauExecutables/Makefile
new file mode 100644
index 000000000..1ec21eac7
--- /dev/null
+++ b/slsDetectorCalibration/jungfrauExecutables/Makefile
@@ -0,0 +1,22 @@
+ROOTSYS=/opt/cern/v6/build
+
+LIBZMQDIR = $(PWD)
+LIBZMQ =  -L$(LIBZMQDIR) -lzmq
+SHLIB_PATH=/opt/cern/v6/root/lib
+CMAKE_PREFIX_PATH=/opt/cern/v6/root
+DYLD_LIBRARY_PATH=/opt/cern/v6/root/lib
+
+QT_CXXFLAGS = $(shell pkg-config --cflags Qt5Core Qt5Gui Qt5Widgets 2>/dev/null)
+QT_LIBS     = $(shell pkg-config --libs Qt5Core Qt5Gui Qt5Widgets 2>/dev/null)
+
+INCDIR=   -I. -I../dataStructures ../tiffio/src/tiffIO.cpp -I../ -I../interpolations/ -I../../slsSupportLib/include/ -I../../slsReceiverSoftware/include/ -I../../libs/rapidjson/ -I../tiffio/include
+LDFLAG= -L/usr/lib64/ -lpthread -lm  -lstdc++  -lzmq -pthread -lrt -ltiff   -O3  -std=c++17 -Wall -Wl,-rpath-link,$(ROOTSYS)/lib
+
+
+default: onlinedisp_zmq
+
+onlinedisp_zmq: onlinedisp_zmq.cpp onlinedisp_zmq.h ../dataStructures/jungfrauLGADStrixelsData_new.h
+	g++ -o onlinedisp_zmq onlinedisp_zmq.cpp $(QT_CXXFLAGS) $(QT_LIBS) -I. -I$(ROOTSYS)/include -Wall -g -lm -L. -lzmq -pthread -lrt -L$(ROOTSYS)/lib -lGui -lCore -lRIO -lNet -lHist -lGraf -lGraf3d -lGpad -lTree -lRint -lPostscript -lMatrix -lPhysics -lMathCore -lThread -m64 -L../../build/bin/ -lSlsSupportStatic ../../build/_deps/libzmq-build/lib/libzmq.a -lstdc++ -lsodium $(LDFLAG) $(INCDIR)
+
+#-lCint
+
diff --git a/slsDetectorCalibration/jungfrauExecutables/onlinedisp_zmq.cpp b/slsDetectorCalibration/jungfrauExecutables/onlinedisp_zmq.cpp
index 4ddacd260..e1d3c7556 100644
--- a/slsDetectorCalibration/jungfrauExecutables/onlinedisp_zmq.cpp
+++ b/slsDetectorCalibration/jungfrauExecutables/onlinedisp_zmq.cpp
@@ -7,6 +7,121 @@ sls::zmqHeader zHeader;
 #define NPRO 50
 #define NPRI 50
 
+// ── ROOT thread safety ───────────────────────────────────────────────────────
+// The main thread FILLS the source accumulator histograms on every processed
+// frame. The ROOT redraw thread must never paint those (ROOT is not
+// thread-safe for concurrent Fill vs Paint - crashes in TH1::SetContour).
+// Instead the ROOT thread paints DISPLAY CLONES whose bin content is copied
+// from the sources once per redraw tick (copying while a fill runs only
+// yields a transiently torn pixel, never a crash).
+std::atomic<uint64_t> gFramesForRoot{0};
+std::atomic<bool> gResetPending{false};
+
+// display clones painted by the ROOT thread (single-owner objects)
+TH2F *disp3000 = nullptr;
+TH2F *disp4500 = nullptr;
+TH2F *dispLvsR = nullptr;
+TH1I *dispChip[8] = {nullptr, nullptr, nullptr, nullptr,
+                     nullptr, nullptr, nullptr, nullptr};
+#ifdef JFSTRX
+TH2F *disp1000 = nullptr; TH2F *disp1001 = nullptr; TH2F *disp1002 = nullptr;
+TH2F *disp1060 = nullptr; TH2F *disp1061 = nullptr; TH2F *disp1062 = nullptr;
+#endif
+
+// copies bin contents + entry count from a source accumulator to its
+// display clone (same geometry). ROOT-thread only.
+static void copyBins(TH1 *dst, TH1 *src) {
+    if (!dst || !src) return;
+    const int bx = dst->GetNbinsX();
+    const int by = dst->GetNbinsY();
+    dst->Reset();
+    if (by <= 1) {
+        for (int b = 1; b <= bx; b++)
+            dst->SetBinContent(b, src->GetBinContent(b));
+    } else {
+        for (int y = 1; y <= by; y++)
+            for (int x = 1; x <= bx; x++)
+                dst->SetBinContent(x, y, src->GetBinContent(x, y));
+    }
+    dst->SetEntries(src->GetEntries());
+}
+
+// ── ROOT GUI ownership ───────────────────────────────────────────────────────
+// ROOT canvas painting + gSystem->ProcessEvents() may ONLY run in the
+// dedicated ROOT thread (thread that drew them crashes otherwise, e.g. in
+// TGaxis/TPaletteAxis). The main thread never touches ROOT graphics; user
+// actions (reset, axes, palette, surf/colz, zoom...) are queued here and
+// executed by the ROOT thread.
+enum class RootCmdType {
+    None, ResetHis, ResetAxes, Surf, Colz,
+    PaletteFalse, PaletteBW1, PaletteBW2, Zoom, SetChipRange
+};
+struct RootCmd {
+    RootCmdType type = RootCmdType::None;
+    double a = 0, b = 0, c = 0, d = 0; // zoom coords / chip range
+};
+std::mutex gCmdMtx;
+std::vector<RootCmd> gCmds;
+
+static void pushRootCmd(RootCmd cmd) {
+    std::lock_guard<std::mutex> lock(gCmdMtx);
+    gCmds.push_back(cmd);
+}
+
+// Executes one queued ROOT command. Only ever called from the ROOT thread.
+static void execRootCmd(const RootCmd &cmd) {
+    switch (cmd.type) {
+    case RootCmdType::ResetHis:
+        historeset();
+        break;
+    case RootCmdType::ResetAxes:
+        axisreset();
+        break;
+    case RootCmdType::Surf:
+        his1000->SetOption("surf2z");
+#ifdef JFSTRX
+        disp1000->SetOption("surf2z");
+#endif
+        Plot2DHistos();
+        break;
+    case RootCmdType::Colz:
+        his1000->SetOption("colz");
+#ifdef JFSTRX
+        disp1000->SetOption("colz");
+#endif
+        if (bw_flag) { bw_flag = false; LoadPaletteFalse(); }
+        Plot2DHistos();
+        break;
+    case RootCmdType::PaletteFalse:
+        LoadPaletteFalse();
+        break;
+    case RootCmdType::PaletteBW1:
+        LoadPaletteBW(1.1111f); bw_flag = true;
+        break;
+    case RootCmdType::PaletteBW2:
+        LoadPaletteBW(0.9f); bw_flag = true;
+        break;
+    case RootCmdType::Zoom:
+        if (disp3000) {
+            disp3000->GetXaxis()->SetRangeUser(cmd.a, cmd.c);
+            disp3000->GetYaxis()->SetRangeUser(cmd.b, cmd.d);
+            A5->cd(); disp3000->Draw("colz");
+            box = new TBox(ROIxmin, ROIymin, ROIxmax, ROIymax);
+            box->SetLineColor(kRed); box->SetFillStyle(0);
+            box->SetLineWidth(2); box->Draw();
+            A5->Update();
+        }
+        break;
+    case RootCmdType::SetChipRange:
+        for (int ih = 0; ih < 8; ih++)
+            dispChip[ih]->GetXaxis()->SetRangeUser(cmd.a, cmd.b);
+        Plot1DHistos();
+        break;
+    default:
+        break;
+    }
+}
