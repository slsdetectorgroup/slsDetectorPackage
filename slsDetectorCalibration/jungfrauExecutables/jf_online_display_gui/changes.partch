+void MainWindow::rootDrawLoop() {
+    auto next = std::chrono::steady_clock::now();
+    while (rootThreadRun.load()) {
+        // service loop every ~20 ms: commands + ROOT GUI events, with
+        // periodic plotting on the rootUpdateMs cadence
+        while (rootThreadRun.load() &&
+               std::chrono::steady_clock::now() < next)
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        if (!rootThreadRun.load())
+            break;
+
+        // 1) execute any user ROOT commands (from the Qt thread)
+        for (;;) {
+            RootCmd cmd;
+            {
+                std::lock_guard<std::mutex> lock(gCmdMtx);
+                if (gCmds.empty()) break;
+                cmd = gCmds.front();
+                gCmds.erase(gCmds.begin());
+            }
+            execRootCmd(cmd);
+        }
+
+        // 2) ROOT GUI event processing lives HERE (single owner thread),
+        //    keeping ROOT canvases interactive (zoom etc.)
+        gSystem->ProcessEvents();
+
+        // 3) periodic plot
+        auto period = std::chrono::milliseconds(rootUpdateMs);
+        if (period.count() < 50)
+            period = std::chrono::milliseconds(50);
+        next = std::chrono::steady_clock::now() + period;
+
+        if (gFramesForRoot.exchange(0) == 0)
+            continue;
+
+        // snapshot the source accumulators into the display clones that the
+        // canvases actually paint (never paint the objects being filled)
+        copyBins(disp3000, his3000);
+        copyBins(disp4500, his4500);
+        copyBins(dispLvsR, hisLvsR);
+        for (int ih = 0; ih < 8; ih++)
+            copyBins(dispChip[ih], hchip[ih]);
+#ifdef JFSTRX
+        copyBins(disp1000, his1000); copyBins(disp1001, his1001);
+        copyBins(disp1002, his1002); copyBins(disp1060, his1060);
+        copyBins(disp1061, his1061); copyBins(disp1062, his1062);
+#endif
+
+        Plot2DHistos();
+        Plot1DHistos();
+        // keep the TvsB/LvsR scatter windows fresh: reset them on the main
+        // thread before the first fill of the next period (the photon map
+        // stays cumulative)
+        gResetPending.store(true);
+    }
+}
